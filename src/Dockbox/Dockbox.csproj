<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite compilar também fora do Windows (CI/Linux). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dockbox.ico</ApplicationIcon>
    <!-- WinForms só para o ícone da bandeja (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Aviso do WinForms sobre DPI no manifesto; o app é WPF e o manifesto está certo. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Dockbox</AssemblyName>
    <RootNamespace>Dockbox</RootNamespace>
    <!-- Versão do app (SemVer). Atualize junto com o CHANGELOG.md. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dockbox.Tests" />
    <!-- Evita conflitos de nomes entre WPF e WinForms (Application, MessageBox, Color...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Dockbox.ico" />
    <Resource Include="Assets\Dockbox-128.png" />
  </ItemGroup>

</Project>
