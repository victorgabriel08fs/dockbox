<Window x:Class="Dockbox.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dockbox"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowDrop="True"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <Canvas x:Name="DockCanvas" ClipToBounds="False">

        <!-- Área quase invisível (alfa 1) que mantém o mouse "dentro" do Dock enquanto os
             ícones estão ampliados. Só fica ativa durante o hover, para não bloquear cliques. -->
        <Rectangle x:Name="HitArea" Fill="Transparent"/>

        <!-- Fundo "vidro" do Dock -->
        <Border x:Name="DockBackground" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="DockShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.4" Color="Black" RenderingBias="Performance"/>
            </Border.Effect>
            <Border x:Name="DockRim" BorderThickness="1" Margin="0"/>
        </Border>

        <!-- Rótulo com o nome do item sob o mouse -->
        <Border x:Name="NameLabel"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="7"
                Padding="11,4,11,5"
                BorderThickness="1"
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="NameLabelText" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"/>
        </Border>

        <!-- Aviso "Item removido · Desfazer" -->
        <Border x:Name="UndoToast"
                Visibility="Collapsed"
                CornerRadius="9"
                Padding="12,6,8,6"
                BorderThickness="1"
                Cursor="Hand"
                Panel.ZIndex="90">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center"/>
                <Border x:Name="UndoButton" CornerRadius="6" Padding="9,2,9,3" Margin="10,0,0,0">
                    <TextBlock Text="Desfazer" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </Border>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
