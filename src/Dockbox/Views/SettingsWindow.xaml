<Window x:Class="Dockbox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Dockbox.Views"
        Title="{l:T S_WindowTitle}"
        Width="940" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiWindowBg}"
        Foreground="{DynamicResource UiFg}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/Dockbox.ico"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ============ Barra lateral ============ -->
        <Border Background="{DynamicResource UiSidebarBg}" BorderBrush="{DynamicResource UiCardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="/Assets/Dockbox-128.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Dockbox" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T S_ManageDock}" FontSize="11.5" Foreground="{DynamicResource UiSubFg}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavItems" Style="{StaticResource UiNavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T S_NavItems}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavWidgets" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T S_NavWidgets}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStyle" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T S_NavStyle}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T S_NavBehavior}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource UiButton}" Content="{l:T S_OpenSettingsFolder}" Click="OpenFolder_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource UiButton}" Content="{l:T S_RestoreDefaults}" Click="Reset_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Conteúdo ============ -->
        <DockPanel Grid.Column="1">
        <!-- Aviso quando o settings.json não pôde ser salvo -->
        <Border x:Name="SaveErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#33E5484D"
                BorderBrush="#99E5484D" BorderThickness="0,0,0,1" Padding="30,12,30,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource UiButton}" Content="{l:T S_RetrySave}"
                        Click="RetrySave_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="SaveErrorText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,24,30,24">

                <!-- ===== Itens ===== -->
                <StackPanel x:Name="PageItems">
                    <TextBlock Text="{l:T S_NavItems}" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16"
                               Text="{l:T S_ItemsSub}"/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource UiAccentButton}" Click="AddApp_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource UiIconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T S_AddApp}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource UiButton}" Content="{l:T S_AddFile}" Click="AddFile_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource UiButton}" Content="{l:T S_AddFolder}" Click="AddFolder_Click"/>
                    </WrapPanel>

                    <Border Style="{StaticResource UiCard}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ItemsList" Height="290" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource UiListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ItemsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="8,4,4,4">
                                <Button x:Name="MoveUpButton" AutomationProperties.Name="{l:T Move_Up}" Style="{StaticResource UiIconButton}" Content="&#xE70E;" Click="MoveUp_Click" Margin="0,0,0,6"/>
                                <Button x:Name="MoveDownButton" AutomationProperties.Name="{l:T Move_Down}" Style="{StaticResource UiIconButton}" Content="&#xE70D;" Click="MoveDown_Click" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource UiIconButton}" Content="&#xE74D;" ToolTip="{l:T Menu_RemoveFromDock}" AutomationProperties.Name="{l:T Menu_RemoveFromDock}" Click="Remove_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="EditCard" Style="{StaticResource UiCard}" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T S_SelectedItem}" Style="{StaticResource UiH2}" Grid.ColumnSpan="3" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="{l:T S_Name}" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditName" AutomationProperties.Name="{l:T S_ItemName}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UiTextBox}" Margin="0,0,0,8" TextChanged="Edit_TextChanged"/>

                            <TextBlock Grid.Row="2" Text="{l:T S_Path}" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditPath" AutomationProperties.Name="{l:T S_ItemPath}" Grid.Row="2" Grid.Column="1" Style="{StaticResource UiTextBox}" Margin="0,0,8,8" LostFocus="EditPath_Commit" KeyDown="EditPath_KeyDown"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource UiButton}" Content="{l:T S_Browse}" Click="BrowsePath_Click" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Text="{l:T S_Arguments}" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditArgs" AutomationProperties.Name="{l:T S_ItemArguments}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UiTextBox}" TextChanged="Edit_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===== Widgets ===== -->
                <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                    <TextBlock Text="{l:T S_NavWidgets}" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16"
                               Text="{l:T S_WidgetsSub}"/>
                    <StackPanel x:Name="WidgetsPanel"/>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_WidgetOptions}" Style="{StaticResource UiH2}" Margin="0,0,0,12"/>
                            <TextBlock Text="{l:T S_WeatherCity}" Style="{StaticResource UiSub}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WeatherCity" AutomationProperties.Name="{l:T S_WeatherCity}" Style="{StaticResource UiTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource UiButton}" Content="{l:T S_Apply}" Click="WeatherApply_Click"/>
                            </Grid>
                            <CheckBox x:Name="WeatherAuto" Style="{StaticResource UiToggle}" Click="WeatherAuto_Click" Margin="0,0,0,14"
                                      Content="{l:T S_AutoLocate}"/>
                            <CheckBox x:Name="Clock24h" Style="{StaticResource UiToggle}" Content="{l:T S_Clock24h}" Click="Clock24h_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Estilo ===== -->
                <StackPanel x:Name="PageStyle" Visibility="Collapsed">
                    <TextBlock Text="{l:T S_NavStyle}" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16" Text="{l:T S_StyleSub}"/>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Theme}" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeAuto" Style="{StaticResource UiSegment}" GroupName="theme" Content="{l:T S_Automatic}" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource UiSegment}" GroupName="theme" Content="{l:T S_Light}" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource UiSegment}" GroupName="theme" Content="{l:T S_Dark}" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeCustom" Style="{StaticResource UiSegment}" GroupName="theme" Content="{l:T S_Custom}" Checked="Theme_Checked"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="CustomColorPanel" Margin="0,14,0,0">
                                <TextBlock Text="{l:T S_BackgroundColor}" Style="{StaticResource UiSub}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <WrapPanel x:Name="BgSwatches"/>
                                    <TextBox x:Name="BgHex" AutomationProperties.Name="{l:T S_BackgroundColorHex}" Style="{StaticResource UiTextBox}" Width="96" Margin="8,0,0,0" LostFocus="BgHex_LostFocus" KeyDown="Hex_KeyDown"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{l:T S_AccentColor}" Style="{StaticResource UiSub}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <WrapPanel x:Name="AccentSwatches"/>
                                <TextBox x:Name="AccentHex" AutomationProperties.Name="{l:T S_AccentColorHex}" Style="{StaticResource UiTextBox}" Width="96" Margin="8,0,0,0" LostFocus="AccentHex_LostFocus" KeyDown="Hex_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Background}" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="{l:T S_Opacity}" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" AutomationProperties.Name="{l:T S_BackgroundOpacity}" Style="{StaticResource UiSlider}" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" Margin="0,0,0,12"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="{l:T S_Corners}" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="RadiusSlider" AutomationProperties.Name="{l:T S_Corners}" Style="{StaticResource UiSlider}" Minimum="0" Maximum="32" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>
                            <CheckBox x:Name="BlurToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Blur}" Click="Toggle_Click" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource UiSub}" TextWrapping="Wrap" Text="{l:T S_BlurHint}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Size}" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="{l:T S_IconSize}" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="SizeSlider" AutomationProperties.Name="{l:T S_IconSize}" Style="{StaticResource UiSlider}" Minimum="32" Maximum="96" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>
                            <CheckBox x:Name="MagnifyToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Magnify}" Click="Toggle_Click" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="MagValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="{l:T S_MagnifyAmount}" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="MagSlider" AutomationProperties.Name="{l:T S_MagnifyAmount}" Style="{StaticResource UiSlider}" Minimum="1.1" Maximum="2.6" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Position}" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EdgeBottom" Style="{StaticResource UiSegment}" GroupName="edge" Content="{l:T S_Bottom}" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeLeft" Style="{StaticResource UiSegment}" GroupName="edge" Content="{l:T S_Left}" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeRight" Style="{StaticResource UiSegment}" GroupName="edge" Content="{l:T S_Right}" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeTop" Style="{StaticResource UiSegment}" GroupName="edge" Content="{l:T S_Top}" Checked="Edge_Checked"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{l:T S_Monitor}" Foreground="{DynamicResource UiSubFg}" Margin="0,16,0,6"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MonitorPrimary" Style="{StaticResource UiSegment}" GroupName="monitorMode" Content="{l:T S_MonitorPrimary}" Checked="MonitorMode_Checked"/>
                                    <RadioButton x:Name="MonitorChoose" Style="{StaticResource UiSegment}" GroupName="monitorMode" Content="{l:T S_MonitorChoose}" Checked="MonitorMode_Checked"/>
                                    <RadioButton x:Name="MonitorFollow" Style="{StaticResource UiSegment}" GroupName="monitorMode" Content="{l:T S_MonitorFollow}" Checked="MonitorMode_Checked"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MonitorListBorder" Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2" Margin="0,8,0,0">
                                <WrapPanel x:Name="MonitorList"/>
                            </Border>
                            <TextBlock x:Name="MonitorHint" Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Comportamento ===== -->
                <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                    <TextBlock Text="{l:T S_NavBehavior}" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16" Text="{l:T S_BehaviorSub}"/>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <CheckBox x:Name="LabelsToggle" Style="{StaticResource UiToggle}" Content="{l:T S_ShowLabels}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RunningToggle" Style="{StaticResource UiToggle}" Content="{l:T S_ShowIndicator}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="UnpinnedToggle" Style="{StaticResource UiToggle}" Content="{l:T S_ShowRunning}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="BounceToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Bounce}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SeparatorToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Separator}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutoHideToggle" Style="{StaticResource UiToggle}" Content="{l:T S_AutoHide}" Click="Toggle_Click" Margin="0,0,0,10"/>
                            <DockPanel x:Name="AutoHideDelayRow" Margin="0,0,0,4">
                                <TextBlock x:Name="AutoHideDelayValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="{l:T S_AutoHideDelay}" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="AutoHideDelaySlider" AutomationProperties.Name="{l:T S_AutoHideDelayA11y}" Style="{StaticResource UiSlider}" Minimum="0" Maximum="1.5" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ReserveToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Reserve}" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="HideTaskbarToggle" Style="{StaticResource UiToggle}" Content="{l:T S_HideTaskbar}" Click="Toggle_Click" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,0,0,14" Text="{l:T S_HideTaskbarHint}"/>
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource UiToggle}" Content="{l:T S_Autostart}" Click="Autostart_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Language}" Style="{StaticResource UiH2}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{l:T S_LanguageSub}"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel x:Name="LanguageChoices" Orientation="Horizontal"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Keyboard}" Style="{StaticResource UiH2}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="{l:T S_KeyboardSub}"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel x:Name="ShortcutChoices" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock x:Name="ShortcutHint" Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource UiSub}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="{l:T S_A11yNote}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="{l:T S_Tips}" Style="{StaticResource UiH2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource UiSub}" LineHeight="20" TextWrapping="Wrap" Text="{l:T S_TipsBody}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
