<Window x:Class="Dockbox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Dock · Dockbox"
        Width="940" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiWindowBg}"
        Foreground="{DynamicResource UiFg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ============ Barra lateral ============ -->
        <Border Background="{DynamicResource UiSidebarBg}" BorderBrush="{DynamicResource UiCardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource UiAccent}">
                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource UiIconFont}" FontSize="16"
                                   Foreground="{DynamicResource UiAccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Dockbox" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Gerenciar Dock" FontSize="11.5" Foreground="{DynamicResource UiSubFg}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavItems" Style="{StaticResource UiNavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="Itens do Dock"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavWidgets" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="Widgets"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStyle" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="Estilo"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource UiNavButton}" GroupName="nav" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource UiIconFont}" FontSize="14" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="Comportamento"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource UiButton}" Content="Abrir pasta de configurações" Click="OpenFolder_Click" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource UiButton}" Content="Restaurar padrões" Click="Reset_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Conteúdo ============ -->
        <DockPanel Grid.Column="1">
        <!-- Aviso quando o settings.json não pôde ser salvo -->
        <Border x:Name="SaveErrorBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#33E5484D"
                BorderBrush="#99E5484D" BorderThickness="0,0,0,1" Padding="30,12,30,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource UiButton}" Content="Tentar salvar de novo"
                        Click="RetrySave_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="SaveErrorText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,24,30,24">

                <!-- ===== Itens ===== -->
                <StackPanel x:Name="PageItems">
                    <TextBlock Text="Itens do Dock" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16"
                               Text="Apps, pastas e arquivos fixados. Você também pode arrastar qualquer arquivo para o Dock."/>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource UiAccentButton}" Click="AddApp_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource UiIconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Adicionar app"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource UiButton}" Content="Adicionar arquivo..." Click="AddFile_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource UiButton}" Content="Adicionar pasta..." Click="AddFolder_Click"/>
                    </WrapPanel>

                    <Border Style="{StaticResource UiCard}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ItemsList" Height="290" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource UiListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ItemsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="8,4,4,4">
                                <Button Style="{StaticResource UiIconButton}" Content="&#xE70E;" ToolTip="Mover para cima (esquerda no Dock)" Click="MoveUp_Click" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource UiIconButton}" Content="&#xE70D;" ToolTip="Mover para baixo (direita no Dock)" Click="MoveDown_Click" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource UiIconButton}" Content="&#xE74D;" ToolTip="Remover do Dock" Click="Remove_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="EditCard" Style="{StaticResource UiCard}" IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Item selecionado" Style="{StaticResource UiH2}" Grid.ColumnSpan="3" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="Nome" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UiTextBox}" Margin="0,0,0,8" TextChanged="Edit_TextChanged"/>

                            <TextBlock Grid.Row="2" Text="Caminho" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditPath" Grid.Row="2" Grid.Column="1" Style="{StaticResource UiTextBox}" Margin="0,0,8,8" LostFocus="EditPath_Commit" KeyDown="EditPath_KeyDown"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource UiButton}" Content="Procurar..." Click="BrowsePath_Click" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Text="Argumentos" VerticalAlignment="Center" Foreground="{DynamicResource UiSubFg}"/>
                            <TextBox x:Name="EditArgs" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource UiTextBox}" TextChanged="Edit_TextChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===== Widgets ===== -->
                <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                    <TextBlock Text="Widgets" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16"
                               Text="Ícones vivos que ficam no fim do Dock, depois do separador. Ligue, desligue e mude a ordem."/>
                    <StackPanel x:Name="WidgetsPanel"/>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Opções dos widgets" Style="{StaticResource UiH2}" Margin="0,0,0,12"/>
                            <TextBlock Text="Cidade do clima" Style="{StaticResource UiSub}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WeatherCity" Style="{StaticResource UiTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource UiButton}" Content="Aplicar" Click="WeatherApply_Click"/>
                            </Grid>
                            <CheckBox x:Name="WeatherAuto" Style="{StaticResource UiToggle}" Click="WeatherAuto_Click" Margin="0,0,0,14"
                                      Content="Sem cidade: detectar pela internet (envia seu IP para o serviço ipwho.is)"/>
                            <CheckBox x:Name="Clock24h" Style="{StaticResource UiToggle}" Content="Relógio em 24 horas" Click="Clock24h_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Estilo ===== -->
                <StackPanel x:Name="PageStyle" Visibility="Collapsed">
                    <TextBlock Text="Estilo" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16" Text="As mudanças aparecem no Dock na hora."/>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Tema" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeAuto" Style="{StaticResource UiSegment}" GroupName="theme" Content="Automático" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource UiSegment}" GroupName="theme" Content="Claro" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource UiSegment}" GroupName="theme" Content="Escuro" Checked="Theme_Checked"/>
                                    <RadioButton x:Name="ThemeCustom" Style="{StaticResource UiSegment}" GroupName="theme" Content="Personalizado" Checked="Theme_Checked"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="CustomColorPanel" Margin="0,14,0,0">
                                <TextBlock Text="Cor do fundo" Style="{StaticResource UiSub}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <WrapPanel x:Name="BgSwatches"/>
                                    <TextBox x:Name="BgHex" Style="{StaticResource UiTextBox}" Width="96" Margin="8,0,0,0" LostFocus="BgHex_LostFocus" KeyDown="Hex_KeyDown"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Cor de destaque (anéis, seleção, botões)" Style="{StaticResource UiSub}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <WrapPanel x:Name="AccentSwatches"/>
                                <TextBox x:Name="AccentHex" Style="{StaticResource UiTextBox}" Width="96" Margin="8,0,0,0" LostFocus="AccentHex_LostFocus" KeyDown="Hex_KeyDown"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Fundo" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="Opacidade" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource UiSlider}" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" Margin="0,0,0,12"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="Cantos arredondados" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="RadiusSlider" Style="{StaticResource UiSlider}" Minimum="0" Maximum="32" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Tamanho" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="Tamanho dos ícones" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="SizeSlider" Style="{StaticResource UiSlider}" Minimum="32" Maximum="96" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>
                            <CheckBox x:Name="MagnifyToggle" Style="{StaticResource UiToggle}" Content="Ampliação ao passar o mouse" Click="Toggle_Click" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="MagValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="Intensidade da ampliação" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="MagSlider" Style="{StaticResource UiSlider}" Minimum="1.1" Maximum="2.6" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Posição na tela" Style="{StaticResource UiH2}" Margin="0,0,0,10"/>
                            <Border Background="{DynamicResource UiInputBg}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EdgeBottom" Style="{StaticResource UiSegment}" GroupName="edge" Content="Embaixo" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeLeft" Style="{StaticResource UiSegment}" GroupName="edge" Content="Esquerda" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeRight" Style="{StaticResource UiSegment}" GroupName="edge" Content="Direita" Checked="Edge_Checked"/>
                                    <RadioButton x:Name="EdgeTop" Style="{StaticResource UiSegment}" GroupName="edge" Content="Em cima" Checked="Edge_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Comportamento ===== -->
                <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                    <TextBlock Text="Comportamento" Style="{StaticResource UiH1}"/>
                    <TextBlock Style="{StaticResource UiSub}" Margin="0,0,0,16" Text="Como o Dock reage aos seus cliques e apps."/>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <CheckBox x:Name="LabelsToggle" Style="{StaticResource UiToggle}" Content="Mostrar o nome ao passar o mouse" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RunningToggle" Style="{StaticResource UiToggle}" Content="Indicador de app aberto (ponto embaixo do ícone)" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="UnpinnedToggle" Style="{StaticResource UiToggle}" Content="Mostrar apps abertos que não estão fixados" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="BounceToggle" Style="{StaticResource UiToggle}" Content="Animação de pulo ao abrir um app" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SeparatorToggle" Style="{StaticResource UiToggle}" Content="Separador entre apps e widgets" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutoHideToggle" Style="{StaticResource UiToggle}" Content="Ocultar e mostrar o Dock automaticamente" Click="Toggle_Click" Margin="0,0,0,10"/>
                            <DockPanel x:Name="AutoHideDelayRow" Margin="0,0,0,4">
                                <TextBlock x:Name="AutoHideDelayValue" DockPanel.Dock="Right" Foreground="{DynamicResource UiSubFg}"/>
                                <TextBlock Text="Tempo com o mouse na borda até aparecer" Foreground="{DynamicResource UiSubFg}"/>
                            </DockPanel>
                            <Slider x:Name="AutoHideDelaySlider" Style="{StaticResource UiSlider}" Minimum="0" Maximum="1.5" ValueChanged="Slider_Changed" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ReserveToggle" Style="{StaticResource UiToggle}" Content="Reservar espaço na tela (janelas maximizadas param antes do Dock)" Click="Toggle_Click" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource UiToggle}" Content="Iniciar o Dockbox junto com o Windows" Click="Autostart_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource UiCard}">
                        <StackPanel>
                            <TextBlock Text="Dicas" Style="{StaticResource UiH2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource UiSub}" LineHeight="20">
                                • Clique num app aberto para trazê-lo para frente; clique de novo para minimizar.<LineBreak/>
                                • Ctrl + clique abre uma nova janela do app.<LineBreak/>
                                • Solte arquivos sobre um app para abri-los com ele, ou sobre a Lixeira para apagar.<LineBreak/>
                                • Botão direito no Dock abre o menu com posição, ampliação e mais opções.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
